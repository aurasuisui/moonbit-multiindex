// Differential (Tier 1) replay against the **Rust reference implementation**.
//
// `src/differential_fixture_test.mbt` records what `multi_index_map` **0.15.1** observed
// after each step of a golden operation stream (generated by `tools/diffgen`). This test
// replays the same stream against our `Table` and asserts the same observations — length,
// the sorted record set, and which ids each of the twelve probe keys answers.
//
// No Rust toolchain is needed here: the fixture is checked in (and its coverage limits are
// documented in `tools/diffgen/README.md` — notably, the reference *panics* on a conflicting
// `modify`, so only the happy path is part of the stream).

///|
/// One record of the differential stream, mirroring the Rust struct field for field.
struct DiffRec {
  id : Int
  ts : Int
  tag : Int
  bin : Int
} derive(Debug, Eq)

///|
/// A table carrying the reference's four index quadrants: `id` hashed-unique, `ts`
/// ordered-unique, `tag` hashed-non-unique, `bin` ordered-non-unique.
fn diff_table() -> @aurasuisui/multiindex.Table[Int, DiffRec] raise {
  let t : @aurasuisui/multiindex.Table[Int, DiffRec] = @aurasuisui/multiindex.Table::new()
  assert_registered(t.register_unique("id", fn(r) { r.id }))
  assert_registered(t.register_unique_ordered("ts", fn(r) { r.ts }))
  assert_registered(t.register_non_unique("tag", fn(r) { r.tag }))
  assert_registered(t.register_non_unique_ordered("bin", fn(r) { r.bin }))
  t
}

///|
/// Every live record as `(id, ts, tag, bin)`, sorted by id — the same normal form the
/// generator emitted (the reference iterates its slab in slot order, which is not a
/// semantic worth pinning).
fn diff_records(
  t : @aurasuisui/multiindex.Table[Int, DiffRec],
) -> Array[(Int, Int, Int, Int)] {
  let out : Array[(Int, Int, Int, Int)] = []
  for _, r in t.iter() {
    out.push((r.id, r.ts, r.tag, r.bin))
  }
  out.sort_by(fn(a, b) { a.0 - b.0 })
  out
}

///|
/// The ids one probe answers, sorted: 0 or 1 for the unique quadrants, the whole
/// bucket for the non-unique ones.
fn diff_probe_ids(
  t : @aurasuisui/multiindex.Table[Int, DiffRec],
  index : String,
  key : Int,
) -> Array[Int] {
  let out : Array[Int] = []
  if index == "id" || index == "ts" {
    match t.get_by(index, key) {
      // both unique probes answer with the record's *id* (that is what the fixture
      // records), whichever key was used to find it
      Some((_, r)) => out.push(r.id)
      None => ()
    }
  } else {
    for _, r in t.iter_by(index, key) {
      out.push(r.id)
    }
  }
  out.sort()
  out
}

///|
fn assert_same_ints(actual : Array[Int], expected : Array[Int]) -> Unit raise {
  @test.assert_eq(actual.length(), expected.length())
  let mut i = 0
  while i < expected.length() {
    @test.assert_eq(actual[i], expected[i])
    i = i + 1
  }
}

///|
fn assert_same_records(
  actual : Array[(Int, Int, Int, Int)],
  expected : Array[(Int, Int, Int, Int)],
) -> Unit raise {
  @test.assert_eq(actual.length(), expected.length())
  let mut i = 0
  while i < expected.length() {
    @test.assert_eq(actual[i], expected[i])
    i = i + 1
  }
}

///|
test "differential: the golden stream matches the Rust reference observations" {
  let t = diff_table()
  let steps = diff_fixture()
  @test.assert_eq(steps.length() > 0, true)
  let mut i = 0
  while i < steps.length() {
    let step = steps[i]
    match step.op {
      "try_insert" => {
        let (id, ts, tag, bin) = step.rec
        match t.insert({ id, ts, tag, bin, }) {
          Ok(_) => @test.assert_eq(step.ok, true)
          Err(_) => @test.assert_eq(step.ok, false)
        }
      }
      "modify_ts" => {
        let (id, ts, _, _) = step.rec
        match t.get_by("id", id) {
          Some((handle, _)) =>
            match t.modify(handle, fn(r) { { ..r, ts, } }) {
              Ok(_) => @test.assert_eq(step.ok, true)
              Err(_) => @test.assert_eq(step.ok, false)
            }
          None => @test.fail("the reference modified a record we do not have")
        }
      }
      "remove" => {
        let (id, _, _, _) = step.rec
        match t.get_by("id", id) {
          Some((handle, _)) =>
            match t.remove(handle) {
              Some(_) => @test.assert_eq(step.ok, true)
              None => @test.assert_eq(step.ok, false)
            }
          None => @test.assert_eq(step.ok, false)
        }
      }
      other => @test.fail("unknown fixture operation: " + other)
    }
    // ---- and now the observations the reference recorded ----
    @test.assert_eq(t.len(), step.len)
    assert_same_records(diff_records(t), step.records)
    let mut p = 0
    while p < step.probes.length() {
      let (index, key, expected) = step.probes[p]
      assert_same_ints(diff_probe_ids(t, index, key), expected)
      p = p + 1
    }
    // a fixture step that leaves the table inconsistent would be caught here too
    match t.verify_invariants() {
      Ok(_) => ()
      Err(message) => @test.fail(message)
    }
    i = i + 1
  }
}
